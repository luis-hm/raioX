# Copie para .env e troque os valores de exemplo antes de subir os serviços.
# db, redis e api são nomes internos do Docker Compose, não endereços do navegador.
# Mantenha a senha igual nas duas linhas; codifique caracteres reservados na URL.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+psycopg://raiox:replace-with-local-password@db:5432/raiox
REDIS_URL=redis://redis:6379/0
RAIOX_RATE_SECRET=replace-with-random-local-secret
RAIOX_UPLOAD_DIR=/data/uploads
# O Next.js usa esta URL dentro do container para encaminhar /api ao backend.
API_URL=http://api:8000
# Endereço do frontend no host: http://127.0.0.1:3000 (ou a porta abaixo).
WEB_PORT=3000
